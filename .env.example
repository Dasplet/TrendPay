# ══ DATABASE ══
DATABASE_URL="postgresql://postgres:password@localhost:5432/trendpay"

# ══ JWT ══
JWT_SECRET="cambia-esto-por-un-secreto-muy-largo-y-aleatorio-minimo-64-chars"
JWT_REFRESH_SECRET="otro-secreto-diferente-para-refresh-tokens-muy-largo"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ══ ENCRYPTION ══
ENCRYPTION_KEY="32-chars-exactos-para-aes256-key"
HMAC_SECRET="secreto-para-hmac-firmas"

# ══ APP ══
NODE_ENV="development"
PORT=3001
APP_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# ══ BCRYPT ══
BCRYPT_ROUNDS=12

# ══ CORS ══
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# ══ RAPYD (pagos) ══
RAPYD_BASE_URL="https://sandboxapi.rapyd.net"
RAPYD_ACCESS_KEY="rak_tu_access_key"
RAPYD_SECRET_KEY="rsk_tu_secret_key"

# ══ TWILIO (SMS/2FA) ══
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ══ AWS (biometría opcional) ══
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# ══ RATE LIMITING ══
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
