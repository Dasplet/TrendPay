{
  "$schema": "https://v2-10-7.turborepo.dev/schema.json",
  "envMode": "loose",
  "globalDependencies": [
    ".env"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {},
    "test:coverage": {
      "outputs": [
        "coverage/**"
      ]
    }
  }
}
