generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════
// USUARIOS
// ══════════════════════════════════════
model User {
  id              String    @id @default(uuid())
  cedula          String    @unique
  nombre          String
  correo          String    @unique
  celular         String?
  ciudad          String?
  pinHash         String    @map("pin_hash")
  rol             String    @default("usuario") // usuario | admin
  subRol          String?   @map("sub_rol")     // super_admin | operador
  kycNivel        Int       @default(1) @map("kyc_nivel")
  kycVerificado   Boolean   @default(false) @map("kyc_verificado")
  bloqueado       Boolean   @default(false)
  bloqueadoHasta  DateTime? @map("bloqueado_hasta")
  intentosPin     Int       @default(0) @map("intentos_pin")
  requiere2fa     Boolean   @default(false) @map("requiere_2fa")
  codigoReferido  String?   @unique @map("codigo_referido")
  referidoPorId   String?   @map("referido_por_id")
  ultimoLogin     DateTime? @map("ultimo_login")

  // Subcuentas empresariales: una cuenta hija no tiene billetera propia, opera
  // sobre la billetera de su cuenta padre. Los permisos limitan qué puede hacer
  // con ese dinero compartido (en cuentas normales y padres siempre son true).
  cuentaPadreId   String?   @map("cuenta_padre_id")
  permisoVerSaldo Boolean   @default(true) @map("permiso_ver_saldo")
  permisoRecargar Boolean   @default(true) @map("permiso_recargar")
  permisoEnviar   Boolean   @default(true) @map("permiso_enviar")
  permisoRetirar  Boolean   @default(true) @map("permiso_retirar")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relaciones
  referidoPor     User?           @relation("Referidos", fields: [referidoPorId], references: [id])
  referidos       User[]          @relation("Referidos")
  cuentaPadre     User?           @relation("Subcuentas", fields: [cuentaPadreId], references: [id])
  subcuentas      User[]          @relation("Subcuentas")
  wallet          Wallet?
  sessions        Session[]
  notifications   Notification[]
  bankAccounts    BankAccount[]
  auditLogs       AuditLog[]
  userAuditLogs   UserAuditLog[]
  referralsGiven  Referral[]      @relation("ReferidorRel")
  referralReceived Referral?      @relation("ReferidoRel")
  withdrawals     Withdrawal[]
  rapydPayments   RapydPayment[]
  kushkiPayments  KushkiPayment[]
  transactions    Transaction[]
  vinculaciones   Vinculacion[]

  @@index([cuentaPadreId])
  @@map("users")
}

// ══════════════════════════════════════
// VINCULACIÓN DE CLIENTES EMPRESARIALES
// ══════════════════════════════════════
// El cliente entra con un enlace privado (solo se guarda el hash del token) y sube
// sus documentos; el equipo de TrendPay los revisa uno por uno desde el panel admin.
model Vinculacion {
  id              String    @id @default(uuid())
  tokenHash       String    @unique @map("token_hash")
  // El mismo enlace sirve durante todo el proceso: se guarda cifrado para poder reenviarlo por correo.
  tokenCifrado    String?   @map("token_cifrado")
  razonSocial     String    @map("razon_social")
  nit             String?
  contactoNombre  String    @map("contacto_nombre")
  contactoCorreo  String    @map("contacto_correo")
  estado          String    @default("invitada") // invitada | en_revision | requiere_correccion | aprobada (documentos) | completada (contrato firmado y validado) | rechazada
  mensaje         String?   // mensaje del equipo al cliente (corrección o rechazo)
  // Contrato: lo sube TrendPay, el cliente lo descarga, lo firma y sube el PDF firmado.
  // Los archivos viven en vinculacion_documentos con tipo "contrato" y "contrato_firmado".
  contratoEstado  String    @default("ninguno") @map("contrato_estado") // ninguno | enviado | firmado | rechazado | aprobado
  contratoMotivo  String?   @map("contrato_motivo")
  expiraAt        DateTime  @map("expira_at")
  enviadaAt       DateTime? @map("enviada_at")
  decididaAt      DateTime? @map("decidida_at")
  creadaPor       String    @map("creada_por")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  creador    User                    @relation(fields: [creadaPor], references: [id])
  documentos VinculacionDocumento[]

  @@index([estado, createdAt(sort: Desc)])
  @@map("vinculaciones")
}

// Archivos de vinculación guardados cifrados en la propia base de datos
// (se usa cuando no hay almacenamiento S3/R2 configurado).
model VinculacionArchivo {
  key       String   @id
  contenido Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("vinculacion_archivos")
}

model VinculacionDocumento {
  id               String    @id @default(uuid())
  vinculacionId    String    @map("vinculacion_id")
  tipo             String    // cedula_rep_legal | rut | camara_comercio | cert_bancaria | composicion_accionaria
  storageKey       String    @map("storage_key")
  nombreOriginal   String    @map("nombre_original")
  mime             String
  tamano           Int
  sha256           String
  fechaExpedicion  DateTime? @map("fecha_expedicion") @db.Date
  estado           String    @default("pendiente") // pendiente | aprobado | rechazado
  motivo           String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  vinculacion Vinculacion @relation(fields: [vinculacionId], references: [id], onDelete: Cascade)

  @@unique([vinculacionId, tipo])
  @@map("vinculacion_documentos")
}

// ══════════════════════════════════════
// WALLETS (BILLETERAS)
// ══════════════════════════════════════
model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  saldo     Decimal  @default(0) @db.Decimal(18, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
  qrCodes      QrCode[]

  @@map("wallets")
}

// ══════════════════════════════════════
// TRANSACCIONES
// ══════════════════════════════════════
model Transaction {
  id            String   @id @default(uuid())
  walletId      String   @map("wallet_id")
  userId        String   @map("user_id")
  codigo        String   @unique
  categoria     String   // consigna | cobro_qr | envio | retiro | comision
  descripcion   String
  montoBruto    Decimal  @map("monto_bruto") @db.Decimal(18, 2)
  comisionPct   Decimal  @default(0) @map("comision_pct") @db.Decimal(5, 2)
  comisionValor Decimal  @default(0) @map("comision_valor") @db.Decimal(18, 2)
  montoNeto     Decimal  @map("monto_neto") @db.Decimal(18, 2)
  saldoAntes    Decimal  @map("saldo_antes") @db.Decimal(18, 2)
  saldoDespues  Decimal  @map("saldo_despues") @db.Decimal(18, 2)
  status        String   @default("exitosa") // exitosa | rechazada | procesado | pendiente
  metadata      Json?    // datos adicionales (banco, referencia externa, etc.)
  createdAt     DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([walletId, createdAt(sort: Desc)])
  @@map("transactions")
}

// ══════════════════════════════════════
// RETIROS
// ══════════════════════════════════════
model Withdrawal {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  bancoId         String?   @map("banco_id")
  bancoNombre     String    @map("banco_nombre")
  tipoCuenta      String    @map("tipo_cuenta")
  nombreTitular   String    @map("nombre_titular")
  numeroCuenta    String    @map("numero_cuenta") // AES-256 encrypted
  cedulaTitular   String    @map("cedula_titular") // AES-256 encrypted
  monto           Decimal   @db.Decimal(18, 2)
  montoNeto       Decimal   @map("monto_neto") @db.Decimal(18, 2)
  status          String    @default("pendiente") // pendiente | en_proceso | procesado | rechazado
  motivo          String?
  notasAdmin      String?   @map("notas_admin")
  payoutTicket    String?   @map("payout_ticket") // ticketNumber de la dispersión en Kushki
  payoutReference String?   @map("payout_reference") // transactionReference de la dispersión
  payoutRespuestas Json?    @map("payout_respuestas") // todas las respuestas de Kushki (exigido por la certificación)
  aprobadoPor     String?   @map("aprobado_por")
  aprobadoAt      DateTime? @map("aprobado_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([payoutTicket])
  @@map("withdrawals")
}

// ══════════════════════════════════════
// BANCOS
// ══════════════════════════════════════
model Bank {
  id         String   @id
  nombre     String
  habilitado Boolean  @default(true)
  nuevo      Boolean  @default(false)
  orden      Int      @default(99)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("banks")
}

// ══════════════════════════════════════
// CUENTAS BANCARIAS DE USUARIOS
// ══════════════════════════════════════
model BankAccount {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  bancoId       String?  @map("banco_id")
  bancoNombre   String   @map("banco_nombre")
  tipoCuenta    String   @map("tipo_cuenta")
  numeroCuenta  String   @map("numero_cuenta") // encrypted
  cedulaTitular String   @map("cedula_titular") // encrypted
  nombreTitular String   @map("nombre_titular")
  alias         String?
  activa        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("bank_accounts")
}

// ══════════════════════════════════════
// QR CODES
// ══════════════════════════════════════
model QrCode {
  id          String    @id @default(uuid())
  walletId    String    @map("wallet_id")
  token       String    @unique
  monto       Decimal?  @db.Decimal(18, 2)
  concepto    String?
  usado       Boolean   @default(false)
  permanente  Boolean   @default(false)
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, permanente])
  @@map("qr_codes")
}

// ══════════════════════════════════════
// SESIONES
// ══════════════════════════════════════
model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  refreshToken String    @unique @map("refresh_token")
  userAgent    String?   @map("user_agent")
  ip           String?
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ══════════════════════════════════════
// NOTIFICACIONES
// ══════════════════════════════════════
model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tipo      String   @default("info")
  titulo    String
  mensaje   String
  leida     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, leida])
  @@map("notifications")
}

// ══════════════════════════════════════
// REFERIDOS
// ══════════════════════════════════════
model Referral {
  id              String   @id @default(uuid())
  referidorId     String   @map("referidor_id")
  referidoId      String   @unique @map("referido_id")
  comisionValor   Decimal  @default(1000) @map("comision_valor") @db.Decimal(18, 2)
  status          String   @default("pendiente") // pendiente | pagado
  pagadoAt        DateTime? @map("pagado_at")
  createdAt       DateTime @default(now()) @map("created_at")

  referidor User @relation("ReferidorRel", fields: [referidorId], references: [id])
  referido  User @relation("ReferidoRel", fields: [referidoId], references: [id])

  @@map("referrals")
}

// ══════════════════════════════════════
// PAGOS RAPYD (consignaciones)
// ══════════════════════════════════════
model RapydPayment {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  reference      String   @unique
  checkoutId     String?  @unique @map("checkout_id")
  monto          Decimal  @db.Decimal(18, 2)
  rapydPaymentId String?  @map("rapyd_payment_id")
  estado         String   @default("pendiente")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("rapyd_payments")
}

// Consignaciones vía Kushki — reemplaza a Rapyd. metodo distingue el flujo
// (PSE se confirma por ticketNumber tras el redirect al banco; tarjeta se
// cobra de inmediato con el token que entrega Kushki.js en el navegador).
model KushkiPayment {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  reference     String   @unique
  metodo        String
  ticketNumber  String?  @unique @map("ticket_number")
  monto         Decimal  @db.Decimal(18, 2)
  estado        String   @default("pendiente")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("kushki_payments")
}

// ══════════════════════════════════════
// CONFIGURACIONES DEL SISTEMA
// ══════════════════════════════════════
model Config {
  id        String   @id @default(uuid())
  clave     String   @unique
  valor     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("configs")
}

// ══════════════════════════════════════
// AUDITORÍA ADMIN
// ══════════════════════════════════════
model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  accion    String
  tabla     String?
  registroId String? @map("registro_id")
  datos     Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_log")
}

// ══════════════════════════════════════
// AUDITORÍA DE USUARIOS (cambios de perfil)
// ══════════════════════════════════════
model UserAuditLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  accion       String
  campo        String?
  valorAntes   String?  @map("valor_antes")
  valorDespues String?  @map("valor_despues")
  ip           String?
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("user_audit_log")
}
